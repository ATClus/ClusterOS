<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClusterOS.Views.TrackerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClusterOS.Views"
    xmlns:model="using:ClusterOS.Models"
    xmlns:helper="using:ClusterOS.Helpers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <helper:DateTimeToStringConverter x:Key="DateTimeToStringConverter"/>
        <helper:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>
    </Page.Resources>
    
    <Grid Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Spacing="12" Margin="0,0,0,12" HorizontalAlignment="center">
            <TextBox x:Name="AppTitleFilterTextBox" 
                     TextChanged="FilterTextBox_TextChanged" 
                     PlaceholderText="App Title"
                     Padding="10 0 0 10"
                     FontSize="18"
                     MinWidth="200"
                     Height="0"
                     BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                     Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                     PlaceholderForeground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            <TextBox x:Name="TabUrlFilterTextBox" 
                     TextChanged="FilterTextBox_TextChanged" 
                     PlaceholderText="Tab URL"
                     Padding="10 0 0 10"
                     FontSize="18"
                     MinWidth="200"
                     Height="0"
                     BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                     Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                     PlaceholderForeground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
            <DatePicker x:Name="DateFilterPicker" 
                        DateChanged="DateFilterPicker_DateChanged"
                        Padding="5"
                        FontSize="18"
                        MinWidth="200"
                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                        Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" />
            <Button Content="Clear" 
                    Background="{ThemeResource SystemAccentColor}"
                    Foreground="White"
                    Height="35"
                    Click="ClearFiltersButton_Click"/>
        </StackPanel>

        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1 1 1 3" Padding="5">
                <TextBlock Text="ID" Padding="5" FontWeight="Bold"/>
            </Border>
            <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="0 1 1 3" Padding="5">
                <TextBlock Text="App Title" Padding="5" FontWeight="Bold"/>
            </Border>
            <Border Grid.Column="2" BorderBrush="LightGray" BorderThickness="0 1 1 3" Padding="5">
                <TextBlock Text="Tab URL" Padding="5" FontWeight="Bold"/>
            </Border>
            <Border Grid.Column="3" BorderBrush="LightGray" BorderThickness="0 1 1 3" Padding="5">
                <TextBlock Text="Date" Padding="5" FontWeight="Bold"/>
            </Border>
            <Border Grid.Column="4" BorderBrush="LightGray" BorderThickness="0 1 1 3" Padding="5">
                <TextBlock Text="Duration" Padding="5" FontWeight="Bold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <ListView x:Name="TrackDataListView" BorderBrush="LightGoldenrodYellow" BorderThickness="1" MaxWidth="850">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="model:TrackDataItemModel">
                        <Border BorderBrush="LightGoldenrodYellow" BorderThickness="0 0 0 2" Padding="0" Margin="-16 0 -16 0" MaxWidth="850">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" BorderBrush="LightGoldenrodYellow" BorderThickness="0 0 1 0" Margin="0 0 15 0" Padding="5">
                                    <TextBlock Text="{x:Bind Id}" FontSize="16" Margin="-10 0 0 0" Padding="0" HorizontalAlignment="Left"/>
                                </Border>
                                <Border Grid.Column="1" BorderBrush="LightGoldenrodYellow" BorderThickness="0 0 1 0" Margin="0 0 6 0" Padding="5">
                                    <TextBlock Text="{x:Bind AppTitle}" FontSize="16" Margin="-5 0 0 0" Padding="0 0 0 0" HorizontalAlignment="Left"/>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="LightGoldenrodYellow" BorderThickness="0 0 1 0" Margin="0 0 -4 0" Padding="5">
                                    <TextBlock Text="{x:Bind TabUrl}" FontSize="16" Margin="5 0 0 0" Padding="0 0 0 0" HorizontalAlignment="Left"/>
                                </Border>
                                <Border Grid.Column="3" BorderBrush="LightGoldenrodYellow" BorderThickness="0 0 1 0" Margin="0 0 -14 0" Padding="5">
                                    <TextBlock Text="{x:Bind Date, Converter={StaticResource DateTimeToStringConverter}}" FontSize="16" Margin="15 0 0 0" Padding="0 0 0 0" HorizontalAlignment="Left"/>
                                </Border>
                                <Border Grid.Column="4" Margin="0 0 0 0" Padding="5">
                                    <TextBlock Text="{x:Bind Duration, Converter={StaticResource TimeSpanToStringConverter}}" FontSize="16" Margin="25 0 0 0" Padding="0 0 0 0" HorizontalAlignment="Left"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid x:Name="LoadingOverlay"
                  Background="#AAFFFFFF"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <ProgressRing IsActive="True"
                      Width="50"
                      Height="50"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
