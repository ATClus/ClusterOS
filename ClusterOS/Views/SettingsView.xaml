<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClusterOS.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClusterOS.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar Grid.Row="0"
                     x:Name="SettingsMenu"
                     SelectionChanged="SelectorBarChanged">
            <SelectorBarItem x:Name="SettingsGeneral"
                             Text="General" 
                             IsSelected="True"/>
            <SelectorBarItem x:Name="SettingsTracker"
                             Text="Tracker" />
            <SelectorBarItem x:Name="SettingsDock"
                             Text="Dock" />
            <SelectorBarItem x:Name="SettingsJournal"
                             Text="Journal" />
            <SelectorBarItem x:Name="SettingsTasks"
                             Text="Tasks" />
            <SelectorBarItem x:Name="SettingsCMS"
                             Text="CMS" />
        </SelectorBar>

        <Frame x:Name="SettingsRoot"
               Grid.Row="1"
               IsNavigationStackEnabled="False" />
    </Grid>
</Page>
