<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClusterOS.Views.DockView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ClusterOS.Views"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="20">
        <!-- Linha 0: Título e descrição -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Linha 1: Expanders ocupando todo o espaço disponível -->
            <RowDefinition Height="*"/>
            <!-- Linha 2: Barra de botões inferior -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Spacing="12">
            <TextBlock Text="Dock Settings" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Customize your Dock according to your preferences" Opacity="0.7"/>
        </StackPanel>

        <!-- Área central com ScrollViewer para caso de overflow -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">

            <!-- Grid para distribuir os três Expanders igualmente -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Expander: Shortcuts -->
                <Expander Header="Shortcuts"
          IsExpanded="True"
          Grid.Column="0"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Stretch"
          VerticalAlignment="Stretch"
          VerticalContentAlignment="Stretch">

                    <StackPanel Spacing="12" Margin="10">
                        <TextBlock Text="Drag to reorder shortcuts:" Margin="0,0,0,8"/>

                        <!-- Aumentar o espaço disponível da lista -->
                        <ListView x:Name="ShortcutsListView"
                  SelectionMode="Single"
                  CanReorderItems="True"
                  AllowDrop="True"
                  CanDragItems="True"
                  MinHeight="300"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ShortcutItem">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Ícone do atalho -->
                                        <Image Source="{x:Bind IconPath}"
                               Width="24"
                               Height="24"
                               Margin="0,0,12,0"/>

                                        <!-- Nome do atalho -->
                                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Name}"
                                   VerticalAlignment="Center"/>

                                        <!-- Botões de reordenação -->
                                        <StackPanel Grid.Column="2"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    Spacing="4">
                                            <!-- Botão "Move Up" -->
                                            <Button Width="32"
                                    Height="32"
                                                    Padding="0"
                                    Background="{ThemeResource SystemAccentColor}"
                                    CornerRadius="4"
                                    Click="MoveUp_Click"
                                    Tag="{x:Bind Id}">
                                                <FontIcon Glyph="&#xE70E;"
                                                    Foreground="White"
                                          FontSize="14"/>
                                                    <ToolTipService.ToolTip>
                                                        <ToolTip Content="Move Up"/>
                                                    </ToolTipService.ToolTip>
                                            </Button>

                                            <!-- Botão "Move Down" -->
                                            <Button Width="32"
                                    Height="32"
                                                    Padding="0"
                                    Background="{ThemeResource SystemAccentColor}"
                                    CornerRadius="4"
                                    Click="MoveDown_Click"
                                    Tag="{x:Bind Id}">
                                                <FontIcon Glyph="&#xE70D;"
                                                    Foreground="White"
                                          FontSize="14"/>
                                                    <ToolTipService.ToolTip>
                                                        <ToolTip Content="Move Down"/>
                                                    </ToolTipService.ToolTip>
                                            </Button>
                                        </StackPanel>

                                        <!-- Botão para remover -->
                                        <Button Grid.Column="3"
                                x:Name="RemoveButton"
                                Width="36"
                                Height="36"
                                Padding="0"
                                Margin="4,0,0,0"
                                Background="{ThemeResource SystemAccentColor}"
                                CornerRadius="4"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="RemoveShortcut_Click"
                                Tag="{x:Bind Id}">
                                            <FontIcon Glyph="&#xE74D;"
                                                Foreground="White"
                                      FontSize="16"/>
                                                <ToolTipService.ToolTip>
                                                    <ToolTip Content="Remove shortcut"/>
                                                </ToolTipService.ToolTip>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Add" Click="AddShortcut_Click" Margin="0,0,8,0"/>
                            <Button Content="Save Order" Click="SaveShortcutOrder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Expander: Appearance -->
                <Expander Header="Appearance"
                          IsExpanded="False"
                          Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          VerticalContentAlignment="Stretch">

                    <StackPanel Spacing="16" Margin="10">
                        <StackPanel>
                            <TextBlock Text="Dock Position" Margin="0,0,0,8"/>
                            <ComboBox x:Name="DockPositionComboBox"
                                      SelectedIndex="0"
                                      Width="200"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="Bottom"/>
                                <ComboBoxItem Content="Top"/>
                                <ComboBoxItem Content="Left"/>
                                <ComboBoxItem Content="Right"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Icon Size" Margin="0,0,0,8"/>
                            <Slider x:Name="IconSizeSlider"
                                    Minimum="24"
                                    Maximum="64"
                                    Value="48"
                                    Width="200"
                                    HorizontalAlignment="Left"
                                    TickFrequency="8"
                                    TickPlacement="Outside"/>
                            <TextBlock Text="{x:Bind IconSizeSlider.Value, Mode=OneWay}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Visual Style" Margin="0,0,0,8"/>
                            <ComboBox x:Name="DockStyleComboBox"
                                      SelectedIndex="0"
                                      Width="200"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="Modern"/>
                                <ComboBoxItem Content="Classic"/>
                                <ComboBoxItem Content="Minimalistic"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Transparency" Margin="0,0,0,8"/>
                            <Slider x:Name="TransparencySlider"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="0.2"
                                    StepFrequency="0.1"
                                    Width="200"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Expander: Behavior -->
                <Expander Header="Behavior"
                          IsExpanded="False"
                          Grid.Column="2"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          VerticalContentAlignment="Stretch">

                    <StackPanel Spacing="16" Margin="10">
                        <ToggleSwitch x:Name="AutoHideToggle"
                                      Header="Auto-hide"
                                      OnContent="On"
                                      OffContent="Off"/>
                        <ToggleSwitch x:Name="AnimationsToggle"
                                      Header="Animations"
                                      IsOn="True"
                                      OnContent="On"
                                      OffContent="Off"/>
                        <ToggleSwitch x:Name="MagnificationToggle"
                                      Header="Magnification effect on hover"
                                      IsOn="True"
                                      OnContent="On"
                                      OffContent="Off"/>
                    </StackPanel>
                </Expander>
            </Grid>
        </ScrollViewer>

        <!-- Barra de botões inferior -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,20,0,0"
                    Spacing="12">
            <Button Content="Start Dock"
                    Click="OpenClusterDock"
                    Width="150"/>
            <Button Content="Stop Dock"
                    Click="StopDock_Click"
                    Width="150"/>
            <Button Content="Apply Settings"
                    Click="ApplySettings_Click"
                    Width="180"/>
            <Button Content="Restore Defaults"
                    Click="RestoreDefaults_Click"
                    Width="150"/>
        </StackPanel>
    </Grid>
</Page>
